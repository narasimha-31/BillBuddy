{
	"name": "billbuddy",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"verify": "npm run check && npm test && npm run build",
		"db:push": "node --env-file=.env migrate.js",
		"test:db": "node --env-file=.env node_modules/vitest/vitest.mjs run --dir supabase/tests"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"supabase": "^2.120.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.117.3"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	}
}
